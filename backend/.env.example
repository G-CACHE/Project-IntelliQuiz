# IntelliQuiz Backend Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to git!

# Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5434/intelliquiz
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=YOUR_DB_PASSWORD_HERE

# JPA Configuration
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_PROPERTIES_HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# Server Configuration
SERVER_PORT=8090
SSL_ENABLED=false

# JWT Configuration
# Generate with: openssl rand -base64 32
JWT_SECRET=GENERATE_YOUR_OWN_SECRET_HERE

# Application Name
APP_NAME=IntelliQuiz-API

# Backup Configuration (local development)
BACKUP_DIR=./backups
DB_HOST=localhost
DB_PORT=5434
DB_NAME=intelliquiz
DB_USERNAME=postgres
DB_PASSWORD=YOUR_DB_PASSWORD_HERE
DB_URL=jdbc:postgresql://localhost:5434/intelliquiz

# Backup execution mode:
# false = run pg_dump/psql directly on this machine (local dev — requires pg_dump installed)
# true  = run pg_dump/psql inside a Docker container via docker exec (Docker/prod)
BACKUP_USE_DOCKER=false
BACKUP_DOCKER_CONTAINER=intelliquiz_db
